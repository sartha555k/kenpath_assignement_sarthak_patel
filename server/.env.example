PORT=4000
DATABASE_URL=postgresql://sweety:sweety@localhost:5432/sweety
# Optional pooled connection for the running API (e.g. Neon).
# Migrations and seed scripts always use DATABASE_URL above.
# DATABASE_URL_POOLED=postgresql://user:password@your-pooler-host/database?sslmode=verify-full
# Use a random secret of at least 32 characters outside tests.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
# Defines 'today' for date validation; reading dates are calendar dates.
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Render's public service proxy: 1. Direct local/Docker access: 0.
# Reassess this count if you add another proxy or CDN in front of the API.
TRUST_PROXY_HOPS=0
# Optional: use a separate PostgreSQL test database instead of embedded PGlite.
# Tests create and drop isolated schemas within this database.
# TEST_DATABASE_URL=postgresql://sweety:sweety@localhost:5432/sweety_test
