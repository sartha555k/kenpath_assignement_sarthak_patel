# Docker Compose settings. Copy this file to .env at the repository root.
# Replace the placeholder with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
POSTGRES_USER=sweety
POSTGRES_PASSWORD=sweety
POSTGRES_DB=sweety
# Host ports; the API stays on the internal Compose network.
WEB_PORT=8080
DB_PORT=5432
# Changing the timezone requires rebuilding the frontend image.
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:8080
